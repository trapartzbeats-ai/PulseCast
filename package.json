{
  "name": "pulsecast-studio",
  "version": "0.3.0-reboot",
  "private": true,
  "description": "Windows-first live production studio under the PulseCast 2.0 reboot blueprint",
  "author": "PulseCast Studio",
  "license": "UNLICENSED",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:5173 && npm run build:main && cross-env PULSECAST_DEV_URL=http://127.0.0.1:5173 electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run typecheck && npm run test && npm run build:renderer && npm run build:main",
    "quality": "npm run lint && npm run format",
    "verify": "npm run quality && npm run build && node scripts/probe-adapters.mjs",
    "package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "package:win:dir": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1 -DirectoryOnly",
    "smoke:packaged": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-packaged.ps1",
    "start": "npm run build && electron .",
    "lint": "eslint src/ tests/ scripts/",
    "format": "prettier --check src/ tests/ scripts/",
    "proof:foundation": "node scripts/generate-proof-report.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "pulse-engine": "file:vendor/pulse-engine/pulse-engine-1.9.0.tgz",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "39.2.7",
    "electron-builder": "26.15.3",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.2.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.1"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "build": {
    "appId": "studio.pulsecast.desktop",
    "productName": "PulseCast Studio",
    "asar": true,
    "directories": {
      "output": "release-reboot"
    },
    "extraResources": [
      {
        "from": "vendor/media",
        "to": "media",
        "filter": [
          "ffmpeg.exe",
          "ffprobe.exe",
          "LICENSE",
          "README.txt",
          "SHA256SUMS"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "dist-electron/**/*",
      "!dist-electron/**/*.map",
      "package.json"
    ],
    "afterPack": "scripts/prune-locales.js",
    "win": {
      "executableName": "PulseCast Studio",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "PulseCast-Studio-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PulseCast Studio",
      "differentialPackage": false,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "PulseCast-Studio-Portable-${version}-${arch}.${ext}",
      "requestExecutionLevel": "user"
    }
  }
}
